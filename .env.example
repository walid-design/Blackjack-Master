# Web app
PORT=4173
BASE_PATH=/
# Enable only when the API and PostgreSQL schema are running. When true, the
# browser cannot choose cards, wagers, actions, balances or payouts.
VITE_SERVER_MODE=false
VITE_API_URL=http://localhost:5000

# API
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/royal_ace
WEB_ORIGIN=http://localhost:4173

# Keep false in any public build until payment-provider approval and signed
# server webhooks are configured. This flag only enables the local no-charge UI.
VITE_ENABLE_DEMO_CHECKOUT=false
